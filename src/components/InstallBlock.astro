---
/**
 * Bordered cyan command block with a copy-to-clipboard button.
 * The command can be passed as a single plain string (for clipboard)
 * plus an optional `parts` array for token-colored rendering.
 */
type CommandPart = {
  type: 'prompt' | 'pkg' | 'arg' | 'flag';
  text: string;
};

type Props = {
  /** Plain string written to the clipboard on copy. */
  command: string;
  /** Optional token-colored parts. If omitted, the command renders plain. */
  parts?: CommandPart[];
};

const { command, parts } = Astro.props;

const colorClass: Record<CommandPart['type'], string> = {
  prompt: 'text-neon-cyan select-none mr-3',
  pkg: 'text-neon-yellow',
  arg: 'text-ink',
  flag: 'text-neon-magenta',
};
---

<div
  class="install grid grid-cols-[minmax(0,1fr)_auto] items-stretch border-[1.5px] border-neon-cyan bg-surface text-ink max-w-[920px] rounded overflow-hidden"
  role="region"
  aria-label="Install command"
>
  <div
    class="font-mono text-[clamp(14px,1.5vw,18px)] leading-[1.4] py-[22px] px-7 overflow-x-auto whitespace-nowrap"
    tabindex="0"
    aria-label="Install command (scrollable)"
  >
    {
      parts && parts.length > 0 ? (
        parts.map((p) => (
          <span
            class={colorClass[p.type]}
            set:html={p.text.replace(/ /g, '&nbsp;')}
          />
        ))
      ) : (
        <span>{command}</span>
      )
    }
  </div>
  <button
    type="button"
    class="copy-btn border-0 border-l-[1.5px] border-rule bg-transparent text-ink-mute-strong font-display font-bold uppercase text-[11px] cursor-pointer min-w-[100px] px-7"
    data-copied="false"
    data-command={command}
    aria-label="Copy install command"
    style="letter-spacing: 0.22em;"
  >
    Copy
  </button>
</div>

<style>
  .install {
    box-shadow:
      0 0 0 1px rgba(108, 243, 251, 0.15),
      0 0 32px rgba(108, 243, 251, 0.18),
      0 12px 40px rgba(0, 0, 0, 0.5);
  }
  .copy-btn {
    transition:
      background 0.15s,
      color 0.15s,
      text-shadow 0.15s;
  }
  .copy-btn:hover {
    color: var(--color-neon-cyan);
    text-shadow: var(--shadow-glow-cyan);
    background: rgba(108, 243, 251, 0.06);
  }
  .copy-btn[data-copied='true'] {
    color: var(--color-neon-magenta);
    text-shadow: var(--shadow-glow-magenta);
    background: rgba(255, 110, 211, 0.08);
  }

  @media (max-width: 520px) {
    .install {
      grid-template-columns: 1fr;
    }
    .copy-btn {
      border-left: 0;
      border-top: 1.5px solid var(--color-rule);
      padding: 14px 28px;
    }
  }
</style>

<script>
  // Tiny copy-to-clipboard wiring, scoped to every InstallBlock on the page.
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    const cmd = btn.dataset.command || '';
    btn.addEventListener('click', () => {
      const done = () => {
        btn.dataset.copied = 'true';
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.dataset.copied = 'false';
          btn.textContent = 'Copy';
        }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(cmd).then(done, () => fallback());
      } else {
        fallback();
      }
      function fallback() {
        const ta = document.createElement('textarea');
        ta.value = cmd;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          done();
        } catch {
          /* ignored */
        }
        document.body.removeChild(ta);
      }
    });
  });
</script>
