---
/**
 * Three-up feature card grid. Cards rotate through the accent colors
 * (magenta / cyan / orange) based on their position in the slot, via
 * the `.feature:nth-child` selectors below. Wrap each card with
 * <FeatureCard>.
 */
---

<div class="features grid grid-cols-1 md:grid-cols-3 gap-[18px]">
  <slot />
</div>

<style is:global>
  .features .feature {
    padding: 32px 28px 36px;
    background: var(--color-surface);
    border: 1.5px solid var(--color-rule);
    border-radius: 4px;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition:
      border-color 0.18s,
      box-shadow 0.18s,
      transform 0.18s;
  }
  .features .feature:hover {
    transform: translateY(-2px);
  }
  .features .feature:nth-child(1) {
    border-color: rgba(255, 110, 211, 0.4);
  }
  .features .feature:nth-child(1):hover {
    border-color: var(--color-neon-magenta);
    box-shadow:
      0 0 0 1px rgba(255, 110, 211, 0.15),
      0 0 30px rgba(222, 27, 176, 0.2);
  }
  .features .feature:nth-child(2) {
    border-color: rgba(108, 243, 251, 0.4);
  }
  .features .feature:nth-child(2):hover {
    border-color: var(--color-neon-cyan);
    box-shadow:
      0 0 0 1px rgba(108, 243, 251, 0.15),
      0 0 30px rgba(44, 213, 222, 0.2);
  }
  .features .feature:nth-child(3) {
    border-color: rgba(255, 155, 110, 0.4);
  }
  .features .feature:nth-child(3):hover {
    border-color: var(--color-neon-orange);
    box-shadow:
      0 0 0 1px rgba(255, 155, 110, 0.15),
      0 0 30px rgba(255, 122, 69, 0.2);
  }

  .features .feature .feature-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 64px;
    line-height: 0.9;
    letter-spacing: 0.02em;
    margin-bottom: 24px;
  }
  .features .feature:nth-child(1) .feature-num {
    color: var(--color-neon-magenta);
    text-shadow: var(--shadow-glow-magenta);
  }
  .features .feature:nth-child(2) .feature-num {
    color: var(--color-neon-cyan);
    text-shadow: var(--shadow-glow-cyan);
  }
  .features .feature:nth-child(3) .feature-num {
    color: var(--color-neon-orange);
    text-shadow: 0 0 12px rgba(255, 155, 110, 0.45);
  }
  @media (max-width: 768px) {
    .features .feature {
      min-height: 0;
    }
  }
</style>
