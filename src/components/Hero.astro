---
import HeroLockup from './HeroLockup.astro';

type Props = {
  /** Monospace eyebrow text, e.g. "WordPress · AI Connector · Dario LLM Router". */
  eyebrow: string;
};

const { eyebrow } = Astro.props;
---

<section
  class="hero relative pt-[clamp(56px,9vw,130px)] pb-[clamp(48px,6vw,96px)]"
>
  <div class="relative z-10">
    <div
      class="font-mono text-xs uppercase text-ink-mute-strong mb-9 inline-flex items-center gap-3"
      style="letter-spacing: 0.22em;"
    >
      <span
        class="pulse w-2 h-2 bg-neon-magenta rounded-full"
        aria-hidden="true"></span>
      {eyebrow}
    </div>

    <HeroLockup />

    <div
      class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_auto] gap-[clamp(28px,4vw,80px)] items-start"
    >
      <div>
        <slot name="headline" />
        <slot name="lede" />
        <div class="mt-13">
          <slot name="install" />
        </div>
        <div
          class="mt-[22px] flex gap-6 flex-wrap font-mono text-xs text-ink-mute-strong"
          style="letter-spacing: 0.06em;"
        >
          <slot name="meta" />
        </div>
      </div>
      <aside aria-label="Latest release">
        <slot name="aside" />
      </aside>
    </div>
  </div>
</section>

<style>
  .pulse {
    box-shadow: var(--shadow-glow-magenta);
  }
  .hero {
    /* allow Background's grid floor to overlap, sit beneath. */
    z-index: 1;
  }
  .mt-13 {
    margin-top: 52px;
  }
</style>
