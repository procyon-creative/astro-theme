---
/**
 * Three-up link card grid. Use <LinkCard> for each entry.
 */
---

<div class="links grid grid-cols-1 md:grid-cols-3 gap-[18px]">
  <slot />
</div>

<style is:global>
  .links .link-card {
    padding: 30px 30px 28px;
    background: var(--color-surface);
    border: 1.5px solid var(--color-rule);
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 200px;
    transition:
      border-color 0.18s,
      box-shadow 0.18s,
      transform 0.18s;
  }
  .links .link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-neon-cyan);
    box-shadow:
      0 0 0 1px rgba(108, 243, 251, 0.15),
      0 0 30px rgba(44, 213, 222, 0.18);
  }
  .links .link-card .arrow {
    transition:
      transform 0.18s,
      text-shadow 0.18s;
  }
  .links .link-card:hover .arrow {
    transform: translateX(8px);
    text-shadow: var(--shadow-glow-cyan);
  }
  @media (max-width: 768px) {
    .links .link-card {
      min-height: 0;
    }
  }
</style>
