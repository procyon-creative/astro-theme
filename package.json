{
  "name": "@procyon-creative/astro-theme",
  "version": "0.1.0",
  "description": "Procyon Creative house-style Astro theme. Tailwind v4, dark navy palette, gradient accents. Landing + docs layouts; optional Starlight overlay.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "homepage": "https://github.com/procyon-creative/astro-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/procyon-creative/astro-theme.git"
  },
  "bugs": {
    "url": "https://github.com/procyon-creative/astro-theme/issues"
  },
  "keywords": [
    "astro-component",
    "astro-theme",
    "tailwindcss",
    "withastro",
    "procyon-creative"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./theme.css": "./src/theme.css",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*"
  },
  "scripts": {
