    "build": "npm --prefix demo run build",
    "preview": "npm --prefix demo run preview"
  },
  "peerDependencies": {
    "astro": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
